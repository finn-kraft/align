#!/usr/bin/env bash
set -euo pipefail

ROOT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VENV_DIR="$ROOT_DIR/.venv"
REQUIREMENTS_FILE="$ROOT_DIR/requirements.txt"
STAMP_FILE="$VENV_DIR/.align-requirements.sha256"

if ! command -v python3 >/dev/null 2>&1; then
  echo "Align requires python3 to create its local environment." >&2
  exit 1
fi

if [ ! -d "$VENV_DIR" ]; then
  echo "Creating $VENV_DIR..."
  python3 -m venv "$VENV_DIR"
fi

if ! command -v sha256sum >/dev/null 2>&1; then
  echo "Align requires sha256sum to track installed dependencies." >&2
  exit 1
fi

REQUIREMENTS_HASH="$(sha256sum "$REQUIREMENTS_FILE" | awk '{print $1}')"
if [ ! -f "$STAMP_FILE" ] || [ "$(cat "$STAMP_FILE")" != "$REQUIREMENTS_HASH" ]; then
  echo "Installing Align dependencies..."
  "$VENV_DIR/bin/python" -m pip install --upgrade pip
  "$VENV_DIR/bin/python" -m pip install -r "$REQUIREMENTS_FILE"
  printf '%s\n' "$REQUIREMENTS_HASH" > "$STAMP_FILE"
fi

MODE="${1:-shiny}"
case "$MODE" in
  shiny)
    exec "$VENV_DIR/bin/shiny" run --reload "$ROOT_DIR/app.py"
    ;;
  test)
    exec "$VENV_DIR/bin/python" -m unittest discover -s "$ROOT_DIR/tests" -v
    ;;
  *)
    echo "Usage: $0 [shiny|test]" >&2
    exit 2
    ;;
esac
